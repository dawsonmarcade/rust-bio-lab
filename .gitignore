# Added by Cargo: contains compiled files, build artifacts, and executables
/target/

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows builds of rustc generate these files containing debugging info
*.pdb

# Rustc internal compiler error (ICE) stack dump files
rustc-ice-*.txt

# cargo-mutants mutation testing data (if you use this tool)
**/mutants.out*/